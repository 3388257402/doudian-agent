# ======================================================================================
# .env.example —— 环境变量名单（CONTRACT §8.4，变量名冻结）
#
# 用法：复制成 `.env`（`.env` 已在 .gitignore 里，永远不会被提交）。
#
#   Windows PowerShell :  Copy-Item .env.example .env
#   macOS / Linux      :  cp .env.example .env
#
# **默认所有值都是空/占位**：不填任何凭据也能跑（dry_run=true + 离线夹具）。
# 需要真实抖店数据时才填 DOUDIAN_* 三个凭据，并把 backend/config/settings.yaml 的
# `doudian.dry_run` 改成 false。
#
# 注意：本文件不是"设置了就生效"的魔法文件——进程启动时读的是**环境变量**。
# 仓库里没有加载 .env 的代码（不加 python-dotenv，少一个依赖），所以你要么让 shell/容器
# 注入（docker compose 已经配好 `env_file: .env`），要么自己 set。见 README「跑起来」。
# ======================================================================================

# --- 抖店开放平台凭据（**默认留空**；dry_run=true 时不会被读取）---
# 申请地址：抖店开放平台 → 应用管理。三个值都缺失且 dry_run=false 时进程启动失败（ConfigError）。
DOUDIAN_APP_KEY=
DOUDIAN_APP_SECRET=
DOUDIAN_ACCESS_TOKEN=

# 店铺 ID（契约 §8.4 列出；后端不读它——后端由 POST /api/agent/run 的请求体给出 shop_id。
# 这里保留是给脚本/前端对齐用，前端自己那份在 frontend/.env.example 的 VITE_SHOP_ID）
DOUDIAN_SHOP_ID=12345678

# --- 通知（飞书群机器人 webhook）---
# 留空 + notifier.mode=dry_run（默认）时通知只写 JSONL 日志，不真的发请求。
# notifier.mode=feishu 时本变量必填，否则启动期 ConfigError。
FEISHU_WEBHOOK_URL=

# --- 数据库（§8.4 白名单：只有这 5 个变量能覆盖 settings.yaml）---
# 开发默认 SQLite（文件在 data/ 下，已被 .gitignore 忽略）。
DATABASE_URL=sqlite+pysqlite:///./data/doudian.db
# 生产切 Postgres：只改这一行（代码零改动，ADR-012），例如
# DATABASE_URL=postgresql+psycopg://doudian:doudian@postgres:5432/doudian

# --- 检查点（LangGraph 持久化；HITL 的审批中断靠它活过重启，ADR-002）---
CHECKPOINT_TYPE=sqlite
CHECKPOINT_PATH=data/checkpoint.db
# CHECKPOINT_TYPE=postgres 时必填：
CHECKPOINT_URL=

# --- 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL ---
LOG_LEVEL=INFO
