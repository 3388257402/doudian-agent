# ======================================================================================
# 前端镜像（Vite 构建 → nginx 静态托管）
#
#   docker build -f Dockerfile.frontend -t doudian-agent-frontend .
#
# 两个关键点：
# 1. `VITE_*` 变量在**构建期**被内联进产物，运行期改无效 —— 所以模式用 build-arg 传。
# 2. nginx 把 `/api/` 反代到 `backend:8000`，浏览器侧同源，不依赖 CORS。
# ======================================================================================
FROM node:20-alpine AS build

WORKDIR /app

# 依赖层：有 package-lock.json 用 `npm ci`（可复现），改源码不会重装依赖
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY frontend/ ./

# 默认 live：浏览器打 `/api/*`，由下面的 nginx 转给后端容器
ARG VITE_API_MODE=live
ARG VITE_SHOP_ID=12345678
ENV VITE_API_MODE=${VITE_API_MODE} \
    VITE_SHOP_ID=${VITE_SHOP_ID}

RUN npm run build


FROM nginx:1.27-alpine AS runtime

# 反代 + SPA 回退写在镜像里（不额外挂配置文件，`docker compose up` 一条命令就够）
RUN printf '%s\n' \
    'server {' \
    '    listen 80;' \
    '    server_name _;' \
    '    root /usr/share/nginx/html;' \
    '    index index.html;' \
    '' \
    '    # API 反代：前端同源访问 /api/*，不触发 CORS 预检' \
    '    location /api/ {' \
    '        proxy_pass http://backend:8000;' \
    '        proxy_http_version 1.1;' \
    '        proxy_set_header Host $host;' \
    '        proxy_set_header X-Real-IP $remote_addr;' \
    '        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;' \
    '        proxy_read_timeout 60s;' \
    '    }' \
    '' \
    '    # SPA：前端路由回退到 index.html' \
    '    location / {' \
    '        try_files $uri $uri/ /index.html;' \
    '    }' \
    '}' > /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
